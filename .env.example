# Runtime and session
DATABASE_URL=mysql://user:password@host:3306/crosaim
JWT_SECRET=generate_a_long_random_secret
OWNER_OPEN_ID=manus_owner_open_id
OAUTH_SERVER_URL=https://oauth.manus.im
VITE_OAUTH_PORTAL_URL=https://oauth.manus.im
VITE_APP_ID=manus_application_id

# Discord web ↔ bot synchronization
CROSAIM_BOT_SYNC_SECRET=set_the_same_value_in_the_bot_runtime
CROSAIM_SIGNED_SYNC_REQUIRED=true
DISCORD_GUILD_ID=replace_with_target_guild_id
CROSAIM_PUBLIC_BASE_URL=https://your-control-center.example

# Discord OAuth2 user account linking; never expose the secret to the client.
DISCORD_CLIENT_ID=discord_application_client_id
DISCORD_CLIENT_SECRET=discord_application_client_secret

# Optional: legacy one-way notices. Normal operational events use the bot queue.
DISCORD_CROSAIM_WEBHOOK_URL=
DISCORD_CLIPS_WEBHOOK_URL=

# Stats providers. Keep keys server-side; never use VITE_* for secrets.
# Tracker Network's documented public API currently supports Apex, The Division 2, CSGO and Splitgate.
TRN_API_KEY=
# VALORANT must use an approved Riot developer key; Tracker is not currently a documented Valorant API provider.
RIOT_API_KEY=
